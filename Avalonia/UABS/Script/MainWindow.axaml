<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:page="clr-namespace:UABS.Page"
        xmlns:vm="clr-namespace:UABS.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="UABS.MainWindow"
        Title="UABS"
        MinWidth="900"
        MinHeight="560"
        Background="#F4F4F4"
        x:DataType="vm:MainWindowViewModel">
    <TabControl x:Name="WorkspaceTabs" SelectedIndex="{Binding SelectedWorkspaceIndex}">
        <TabItem Header="Assets">
            <page:AssetsWorkspaceView/>
        </TabItem>
        <TabItem Header="Search">
            <page:SearchWorkspaceView DataContext="{Binding Search}"/>
        </TabItem>
        <TabItem Header="Packages">
            <page:PackageManagementView DataContext="{Binding Packages}"/>
        </TabItem>
    </TabControl>

</Window>

