<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:options="clr-namespace:UABS.Options"
        xmlns:page="clr-namespace:UABS.Page"
        xmlns:vm="clr-namespace:UABS.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="UABS.MainWindow"
        Title="UABS"
        Background="#F4F4F4"
        x:DataType="vm:MainWindowViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- MainContent -->
        </Grid.RowDefinitions>

        <options:Toolbar Grid.Row="0"/>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedWorkspaceIndex}">
            <TabItem Header="Assets">
                <Grid ColumnDefinitions="460,4,*">
                    <page:BrowserView DataContext="{Binding Browser}"/>
                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#D0D0D0"/>
                    <page:FolderView Grid.Column="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="Packages">
                <page:PackageManagementView DataContext="{Binding Packages}"/>
            </TabItem>
        </TabControl>
    </Grid>

</Window>

