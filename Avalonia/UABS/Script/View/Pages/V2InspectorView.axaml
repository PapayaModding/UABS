<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UABS.ViewModels" xmlns:page="clr-namespace:UABS.Page"
             x:Class="UABS.Page.V2InspectorView" x:DataType="vm:V2BrowseViewModel">
    <ScrollViewer Margin="8">
        <StackPanel Spacing="8">
            <TextBox x:Name="V2ReadOnlyInspector" Text="{Binding Inspector, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="350"
                     AutomationProperties.Name="Read-only V2 asset metadata and memo"/>
            <page:EditableMemoInspectorView x:Name="V2MemoInspector" DataContext="{Binding MemoInspector}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
