<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:assets="clr-namespace:UABS.UnityAssets;assembly=UABS.UnityAssets"
             xmlns:vm="clr-namespace:UABS.ViewModels"
             x:Class="UABS.Page.FolderView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8,12,12,12" RowSpacing="8">
        <Border Grid.Row="0" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10,7">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <TextBlock Text="Open file:" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding ActiveFilePath}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4"/>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Add Selected to Package" Command="{Binding AddSelectedAssetToPackageCommand}"/>
            <Button Grid.Column="2" Content="Open File..." Command="{Binding OpenFileCommand}"/>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,*,140,150,Auto" ColumnSpacing="6">
            <TextBox Watermark="Filter name" Text="{Binding AssetList.NameFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="1" Watermark="Filter type" Text="{Binding AssetList.TypeFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Grid.Column="2" Watermark="Path ID" Text="{Binding AssetList.PathIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding AssetList.SortFields}" SelectedItem="{Binding AssetList.SortField}"/>
            <CheckBox Grid.Column="4" Content="Descending" IsChecked="{Binding AssetList.SortDescending}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="4">
            <DataGrid AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      ItemsSource="{Binding AssetList.Assets}"
                      SelectedItem="{Binding AssetList.SelectedAsset}"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="assets:AssetEntry">
                                <Image Source="{Binding Type, Converter={StaticResource AssetTypeIconConvertor}}"
                                       Width="24" Height="24" Stretch="Uniform"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                    <DataGridTextColumn Header="Class ID" Binding="{Binding ClassId}" Width="85"/>
                    <DataGridTextColumn Header="Path ID" Binding="{Binding PathId}" Width="105"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding ByteSize}" Width="90"/>
                    <DataGridTextColumn Header="File" Binding="{Binding LogicalFile}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="#FFF2F2" BorderBrush="#D94848" BorderThickness="1" CornerRadius="4"
                    Padding="12" VerticalAlignment="Top" Margin="8" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9A2020" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <Border Grid.Row="5" Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="Asset details" FontWeight="SemiBold"/>
                <ProgressBar Grid.Row="1" IsVisible="{Binding AssetList.IsDetailsLoading}" IsIndeterminate="True" Height="3" Margin="0,6"/>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="3"
                      IsVisible="{Binding AssetList.HasDetails}">
                    <TextBlock Text="Name:" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding AssetList.SelectedDetails.Name}"/>
                    <TextBlock Grid.Column="2" Text="Type:" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{Binding AssetList.SelectedDetails.Type}"/>
                    <TextBlock Grid.Row="1" Text="Path ID:" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AssetList.SelectedDetails.PathId}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Size:" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding AssetList.SelectedDetails.ByteSize}"/>
                    <TextBlock Grid.Row="2" Text="Unity:" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AssetList.SelectedDetails.UnityVersion}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Source file:" FontWeight="SemiBold"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding AssetList.SelectedDetails.LogicalFile}"/>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding AssetList.DetailsError}" Foreground="#9A2020"
                           IsVisible="{Binding AssetList.HasDetailsError}" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
