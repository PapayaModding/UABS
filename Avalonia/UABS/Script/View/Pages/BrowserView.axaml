<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UABS.Models"
             xmlns:vm="clr-namespace:UABS.ViewModels"
             x:Class="UABS.Page.BrowserView"
             x:DataType="vm:BrowserViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,12,4,12" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button Content="Back" Command="{Binding BackCommand}"/>
            <Button Content="Forward" Command="{Binding ForwardCommand}"/>
            <Button Content="Up" Command="{Binding UpCommand}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            <Button Content="Choose..." Command="{Binding ChooseFolderCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Text="{Binding LocationInput, UpdateSourceTrigger=PropertyChanged}" Watermark="Folder path"/>
            <Button Grid.Column="1" Content="Go" Command="{Binding GoCommand}"/>
        </Grid>

        <ProgressBar Grid.Row="2" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4"/>

        <DataGrid Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="75"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="65"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6">
            <Button Content="Open Selected" Command="{Binding OpenSelectedCommand}" HorizontalAlignment="Right"/>
            <Border Grid.Row="1" Background="#FFF2F2" BorderBrush="#D94848" BorderThickness="1" CornerRadius="4"
                    Padding="8" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9A2020" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
