<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:UABS.Models"
             xmlns:vm="clr-namespace:UABS.ViewModels"
             x:Class="UABS.Page.BrowserView"
             x:DataType="vm:BrowserViewModel">
    <UserControl.Resources>
        <StreamGeometry x:Key="NavigatorFolderGeometry">M 1,5 L 8,5 L 10,7 L 19,7 L 19,17 L 1,17 Z</StreamGeometry>
        <StreamGeometry x:Key="NavigatorFileGeometry">M 4,1 L 12,1 L 18,7 L 18,19 L 4,19 Z</StreamGeometry>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12,12,4,12" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6">
            <Button Content="Back" Command="{Binding BackCommand}"/>
            <Button Content="Forward" Command="{Binding ForwardCommand}"/>
            <Button Content="Up" Command="{Binding UpCommand}"/>
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            <Button Content="Choose..." Command="{Binding ChooseFolderCommand}"/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Text="{Binding LocationInput, UpdateSourceTrigger=PropertyChanged}" Watermark="Folder path"/>
            <Button Grid.Column="1" Content="Go" Command="{Binding GoCommand}"/>
        </Grid>

        <ProgressBar Grid.Row="2" IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="4"/>

        <Grid Grid.Row="3">
            <DataGrid x:Name="EntriesGrid"
                      Classes="navigatorList"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="True"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      LoadingRow="OnEntriesGridLoadingRow"
                      Tapped="OnEntriesTapped"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn SortMemberPath="Kind"
                                            Width="52"
                                            MinWidth="0"
                                            MaxWidth="80"
                                            CanUserResize="True"
                                            CellTheme="{StaticResource KindIconCellTheme}"
                                            CanUserSort="False">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="" AutomationProperties.Name="Kind"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:BrowserEntry">
                                <Grid x:Name="KindIconHost"
                                      Width="20" Height="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{Binding Kind}"
                                      AutomationProperties.Name="{Binding Kind}">
                                    <PathIcon Classes="navigatorKindIcon navigatorFolderKindIcon"
                                              Data="{StaticResource NavigatorFolderGeometry}"
                                              IsVisible="{Binding IsDirectory}"
                                              AutomationProperties.Name="Directory"/>
                                    <PathIcon Classes="navigatorKindIcon navigatorFileKindIcon"
                                              Data="{StaticResource NavigatorFileGeometry}"
                                              IsVisible="{Binding !IsDirectory}"
                                              AutomationProperties.Name="File"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="65"/>
                    <DataGridTextColumn Header="Modified" Binding="{Binding LastModified}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyFolderMessage"
                       Text="No supported Unity asset files found in this folder."
                       IsVisible="{Binding ShowEmptyMessage}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="24"/>
        </Grid>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="6">
            <Button Content="Open Selected" Command="{Binding OpenSelectedCommand}" HorizontalAlignment="Right"/>
            <Border Grid.Row="1" Background="#FFF2F2" BorderBrush="#D94848" BorderThickness="1" CornerRadius="4"
                    Padding="8" IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9A2020" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
