<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UABS.ViewModels"
             x:Class="UABS.Options.Toolbar"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <StyleInclude Source="avares://UABS/Script/Styles/ToolbarStyle.axaml"/>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Background="#FFFFFF" Spacing="10">
        <Button Content="File" Classes="toolbarButton">
            <Button.Flyout>
                <MenuFlyout>
                    <MenuItem Header="Open File..." Command="{Binding OpenFileCommand}"/>
                    <MenuItem Header="Open Folder..." Command="{Binding Browser.ChooseFolderCommand}"/>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
        <Button Content="Export" Classes="toolbarButton" IsEnabled="False" ToolTip.Tip="Planned for a later milestone"/>
        <Button Content="Search" Classes="toolbarButton" Command="{Binding ShowPackagesCommand}" ToolTip.Tip="Open package metadata search"/>
        <Button Content="Depend" Classes="toolbarButton" Command="{Binding ShowPackagesCommand}" ToolTip.Tip="Open direct package dependencies"/>
        <Button Content="Filter" Classes="toolbarButton" IsEnabled="False"/>
        <Button Content="Memo" Classes="toolbarButton" IsEnabled="False"/>
        <Button Content="Package" Classes="toolbarButton" Command="{Binding ShowPackagesCommand}"/>
        <Button Content="Back" Classes="toolbarButton" Command="{Binding Browser.BackCommand}"/>
        <Button Content="Forward" Classes="toolbarButton" Command="{Binding Browser.ForwardCommand}"/>
        <Button Content="Up" Classes="toolbarButton" Command="{Binding Browser.UpCommand}"/>
        <Button Content="Refresh" Classes="toolbarButton" Command="{Binding Browser.RefreshCommand}"/>
    </StackPanel>

</UserControl>
